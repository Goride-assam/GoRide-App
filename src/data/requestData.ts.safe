import {
  collection,
  addDoc,
  updateDoc,
  doc,
  getDocs,
  query,
  orderBy,
  limit,
  onSnapshot,
  Unsubscribe,
} from "firebase/firestore";

import { db } from "../config/firebase";

export let rideRequest: any = null;

let unsubscribeRequest: Unsubscribe | null = null;

const ACTIVE_STATUSES = [
  "New Ride Request",
  "Driver Accepted 🚗",
  "Ride Started 🛺",
];

export async function createRequest(ride: any) {
  console.log("========== CREATE REQUEST ==========");

  const requestData = {
    ...ride,
    requestStatus: "New Ride Request",
    createdAt: Date.now(),
  };

  console.log(
    "REQUEST BEING SENT TO FIREBASE:",
    requestData
  );

  const ref = await addDoc(
    collection(db, "rideRequests"),
    requestData
  );

  rideRequest = {
    ...requestData,
    id: ref.id,
  };

  console.log(
    "FIREBASE REQUEST CREATED:",
    rideRequest
  );

  return rideRequest;
}

export async function getRequest() {
  console.log("========== GET REQUEST ==========");

  try {
    const requestsQuery = query(
      collection(db, "rideRequests"),
      orderBy("createdAt", "desc"),
      limit(20)
    );

    const snapshot = await getDocs(
      requestsQuery
    );

    if (snapshot.empty) {
      rideRequest = null;
      return null;
    }

    const requests = snapshot.docs
      .map((item) => ({
        id: item.id,
        ...item.data(),
      }))
      .sort(
        (a: any, b: any) =>
          Number(b.createdAt || 0) -
          Number(a.createdAt || 0)
      );

    const activeRequest = requests.find(
      (item: any) =>
        ACTIVE_STATUSES.includes(
          String(
            item.requestStatus || ""
          ).trim()
        )
    );

    if (!activeRequest) {
      rideRequest = null;
      return null;
    }

    rideRequest = activeRequest;

    console.log(
      "ACTIVE REQUEST FOUND:",
      rideRequest
    );

    return rideRequest;
  } catch (error) {
    console.log(
      "GET REQUEST ERROR:",
      error
    );

    return null;
  }
}

export async function updateRequestStatus(
  status: string
) {
  console.log(
    "========== UPDATE REQUEST STATUS =========="
  );

  if (!rideRequest?.id) {
    console.log(
      "NO CURRENT REQUEST ID"
    );
    return;
  }

  await updateDoc(
    doc(
      db,
      "rideRequests",
      rideRequest.id
    ),
    {
      requestStatus: status,
      updatedAt: Date.now(),
    }
  );

  rideRequest = {
    ...rideRequest,
    requestStatus: status,
  };

  console.log(
    "REQUEST STATUS UPDATED:",
    rideRequest
  );
}

export function listenToLatestRequest(
  callback: (request: any | null) => void
) {
  console.log(
    "========== REQUEST LISTENER START =========="
  );

  if (unsubscribeRequest) {
    unsubscribeRequest();
    unsubscribeRequest = null;
  }

  const requestsQuery = query(
    collection(db, "rideRequests"),
    orderBy("createdAt", "desc"),
    limit(20)
  );

  unsubscribeRequest = onSnapshot(
    requestsQuery,
    (snapshot) => {
      console.log(
        "FIREBASE SNAPSHOT:",
        snapshot.size
      );

      const requests = snapshot.docs
        .map((item) => ({
          id: item.id,
          ...item.data(),
        }))
        .sort(
          (a: any, b: any) =>
            Number(b.createdAt || 0) -
            Number(a.createdAt || 0)
        );

      const activeRequest = requests.find(
        (item: any) =>
          ACTIVE_STATUSES.includes(
            String(
              item.requestStatus || ""
            ).trim()
          )
      );

      if (!activeRequest) {
        rideRequest = null;
        callback(null);
        return;
      }

      rideRequest = activeRequest;

      console.log(
        "🔥 ACTIVE REQUEST:",
        rideRequest
      );

      callback(rideRequest);
    },
    (error) => {
      console.log(
        "REALTIME REQUEST ERROR:",
        error
      );

      callback(null);
    }
  );

  return () => {
    if (unsubscribeRequest) {
      unsubscribeRequest();
      unsubscribeRequest = null;
    }
  };
}

export function stopRequestListener() {
  if (unsubscribeRequest) {
    unsubscribeRequest();
    unsubscribeRequest = null;
  }
}
